import "abla/io"
import "abla/process/arguments"
import "abla/process/time"

fun fixtureInt(value: string): int {
    var result = 0
    var index = 0
    while (index < value.size) {
        result = result * 10 + value[index] - 48
        index = index + 1
    }
    result
}

fun main: int {
    val delay = fixtureInt(processArgument(0))
    val status = fixtureInt(processArgument(1))
    val message = processArgument(2)
    sleep(delay)
    print("$message\n")
    status
}
