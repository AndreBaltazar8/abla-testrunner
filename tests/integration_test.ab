import "../src/testrunner.ab"
import "abla/fs"
import "abla/process/time"

/** How many malformed output expectations the loader fails to reject: 0 when it rejects them all. */
fun outputManifestErrors(): int {
    val steps = [
        "\"outputEquals\": 5",
        "\"outputContains\": \"one\"",
        "\"outputContains\": [1]",
        "\"outputContains\": [\"\"]",
        "\"outputExcludes\": [\"\"]",
        "\"files\": \"x\"",
        "\"files\": [\"x\"]",
        "\"files\": [{\"path\": \"p\"}]",
        "\"files\": [{\"path\": \"p\", \"equals\": \"a\", \"contains\": \"b\"}]",
        "\"files\": [{\"equals\": \"a\"}]"
    ]
    var accepted = 0
    var index = 0
    while (index < steps.size) {
        val manifest = "{\"version\":1,\"tests\":[{\"name\":\"t\",\"steps\":[{\"command\":\"c\"," +
            steps[index] + "}]}]}"
        if (loadTestSuite(manifest).error == "") accepted = accepted + 1
        index = index + 1
    }
    val valid =
        "{\"version\":1,\"tests\":[{\"name\":\"t\",\"steps\":[{\"command\":\"c\",\"outputContains\":[\"x\"],\"files\":[{\"path\":\"p\",\"contains\":\"a\"}]}]}]}"
    if (loadTestSuite(valid).error != "") accepted = accepted + 100
    accepted
}

fun main: int {
    val root = currentDirectory().text
    val started = monotonicMilliseconds()
    val passed = runTestCommand(["--file", "tests/pass.json", "--jobs", "4"])
    val elapsed = monotonicMilliseconds() - started
    val failed = runTestCommand(["--file", "tests/fail.json"])
    val filtered = runTestCommand([
        "--file", "tests/pass.json", "--filter", "exclusive-final"
    ])
    val variable = runTestCommand([
        "--file", "tests/variables.json",
        "--set", "fixture=$root/build/fixture"
    ])
    val dependencySuite = loadTestSuite(
        path("$root/tests/dependencies.json").readText()
    )
    val dependencySummary = runTestSuite(
        dependencySuite.suite,
        TestRunnerOptions(
            root, "tests/dependencies.json", 4, "dependency-leaf",
            false, false, [], []
        )
    )
    val failureSuite = loadTestSuite(
        path("$root/tests/dependency-fail.json").readText()
    )
    val failureSummary = runTestSuite(
        failureSuite.suite,
        TestRunnerOptions(
            root, "tests/dependency-fail.json", 4, "",
            false, false, [], []
        )
    )
    val negatives = outputManifestErrors()
    val leftover = path("$root/build/test-results/output-fail/should-not-exist.out")
    if (leftover.info().isFile()) leftover.remove()
    val outputPassed = runTestCommand(["--file", "tests/output-pass.json"])
    val outputSuite = loadTestSuite(path("$root/tests/output-fail.json").readText())
    val outputSummary = runTestSuite(
        outputSuite.suite,
        TestRunnerOptions(
            root, "tests/output-fail.json", 2, "", false, false, [], []
        )
    )
    if (negatives != 0) 11
    else if (outputPassed != 0) 8
    else if (outputSuite.error != "" || outputSummary.passed != 0 ||
        outputSummary.failed != 7 || outputSummary.skipped != 0) 9
    else if (leftover.info().isFile()) 10
    else if (passed != 0) 1
    else if (elapsed >= 1800) 2
    else if (failed != 1) 3
    else if (filtered != 0) 4
    else if (variable != 0) 5
    else if (dependencySuite.error != "" ||
        dependencySummary.passed != 3 || dependencySummary.failed != 0 ||
        dependencySummary.skipped != 0 ||
        dependencySummary.durationMilliseconds < 280) 6
    else if (failureSuite.error != "" || failureSummary.passed != 0 ||
        failureSummary.failed != 1 || failureSummary.skipped != 1) 7
    else 0
}
