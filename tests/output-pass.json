{
  "version": 1,
  "jobs": 2,
  "timeoutMs": 5000,
  "logDirectory": "build/test-results/output-pass",
  "tests": [
    {
      "name": "equals",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "printf 'one\\ntwo\\n'"],
        "outputEquals": "one\ntwo\n"
      }]
    },
    {
      "name": "contains-and-excludes",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "echo alpha beta; echo gamma >&2"],
        "outputContains": ["alpha", "gamma", "beta"],
        "outputExcludes": ["delta"]
      }]
    },
    {
      "name": "file-checks",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "printf 'key=value\\n' > ${log}/file-checks.out"],
        "files": [
          {"path": "${log}/file-checks.out", "equals": "key=value\n"},
          {"path": "${log}/file-checks.out", "contains": "=val"}
        ]
      }]
    },
    {
      "name": "line-in-order",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "echo first line; echo 'error[E_X]: thing:ticket here'; echo last"],
        "outputLineContainsInOrder": [["error[E_", "]:", ":ticket"], ["first", "line"]]
      }]
    },
    {
      "name": "line-regex",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "echo 'error[E_X]: ownership.move-required:local.x:ticket'; echo 'last line 42'"],
        "outputLineMatches": ["ownership\\.move-required:local.*:ticket", "^last line [0-9]+$", "E_(X|Y)\\]"]
      }]
    },
    {
      "name": "status-and-output",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "echo failing as expected; exit 3"],
        "expect": 3,
        "outputContains": ["as expected"]
      }]
    }
  ]
}
