{
  "version": 1,
  "jobs": 2,
  "timeoutMs": 5000,
  "logDirectory": "build/test-results/output-fail",
  "tests": [
    {
      "name": "equals-differs",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "printf 'one\\n'"],
        "outputEquals": "one"
      }]
    },
    {
      "name": "contains-missing",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "echo alpha"],
        "outputContains": ["alpha", "beta"]
      }]
    },
    {
      "name": "excluded-present",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "echo alpha beta"],
        "outputExcludes": ["beta"]
      }]
    },
    {
      "name": "file-missing",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "true"],
        "files": [{"path": "${log}/never-written.out", "contains": ""}]
      }]
    },
    {
      "name": "file-present-but-absent-wanted",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "printf 'a' > ${log}/file-present.out"],
        "files": [{"path": "${log}/file-present.out", "absent": true}]
      }]
    },
    {
      "name": "file-differs",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "printf 'a' > ${log}/file-differs.out"],
        "files": [{"path": "${log}/file-differs.out", "equals": "b"}]
      }]
    },
    {
      "name": "later-step-skipped-after-output-failure",
      "steps": [
        {"command": "/bin/sh", "args": ["-c", "echo first"], "outputContains": ["second"]},
        {"command": "/bin/sh", "args": ["-c", "echo ran > ${log}/should-not-exist.out"]}
      ]
    },
    {
      "name": "needles-on-different-lines",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "echo alpha; echo beta"],
        "outputLineContainsInOrder": [["alpha", "beta"]]
      }]
    },
    {
      "name": "needles-in-the-wrong-order",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "echo beta alpha"],
        "outputLineContainsInOrder": [["alpha", "beta"]]
      }]
    },
    {
      "name": "regex-matches-no-line",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "echo alpha"],
        "outputLineMatches": ["alpha", "beta"]
      }]
    },
    {
      "name": "regex-anchored-per-line",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "echo alpha; echo beta"],
        "outputLineMatches": ["^alpha.*beta$"]
      }]
    },
    {
      "name": "regex-dot-does-not-match-newline",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "printf 'a\\nb\\n'"],
        "outputLineMatches": ["a.b"]
      }]
    },
    {
      "name": "output-ok-but-status-wrong",
      "steps": [{
        "command": "/bin/sh",
        "args": ["-c", "echo fine; exit 2"],
        "outputContains": ["fine"]
      }]
    }
  ]
}
